{
  "name": "ccdata-yf-05-license-lens",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test:engine": "esbuild test/engine.test.ts --bundle --platform=node --format=cjs --outfile=node_modules/.tmp/engine.test.cjs --log-level=warning && node node_modules/.tmp/engine.test.cjs",
    "test:ui": "esbuild test/ui.test.tsx --bundle --platform=node --format=cjs --jsx=automatic --external:jsdom --outfile=node_modules/.tmp/ui.test.cjs --log-level=warning && node node_modules/.tmp/ui.test.cjs",
    "test": "npm run test:engine && npm run test:ui"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "esbuild": "latest",
    "jsdom": "^29.1.1"
  }
}
